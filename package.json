{
  "name": "frameedit",
  "version": "0.1.0",
  "description": "Lightweight layered video editor",
  "main": "electron/main.js",
  "author": "FrameEdit",
  "scripts": {
    "start": "electron --no-sandbox .",
    "dist": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.frameedit.app",
    "productName": "FrameEdit",
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/ffprobe-static/**"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Video"
    }
  }
}
